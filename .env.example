# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://localhost:5432/oracle

# PPQ gateway (OpenAI-compatible). Point LLM_BASE_URL at Anthropic-compatible
# providers only if you also change the SDK — this speaks the OpenAI shape.
LLM_API_KEY=
LLM_BASE_URL=https://api.ppq.ai/v1
VOICE_MODEL=anthropic/claude-sonnet-4.6
JUDGE_MODEL=claude-haiku-4.5

TELEGRAM_BOT_TOKEN=
# polling on an always-on host, webhook on one that sleeps when idle
BOT_MODE=polling

# Bearer token for POST /v1/petition. Generate with:
#   node -e "console.log('orc_'+require('crypto').randomBytes(32).toString('hex'))"
ORACLE_API_KEY=
# Comma-separated browser origins. Leave empty for server-to-server only.
ALLOWED_ORIGINS=

SILENCE_MINUTES=720
